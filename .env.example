# Database Connection (SQLite untuk local dev, PostgreSQL untuk production)
DATABASE_URL="file:./dev.db"

# Autentikasi JWT
JWT_SECRET="ganti_dengan_random_secret_minimal_32_karakter"

# Zona Waktu Operasional Default
APP_TIMEZONE="Asia/Jakarta"

# Environment Mode
NODE_ENV="development"

# OpenRouter AI & Fish Audio S2.1 Pro TTS
OPENROUTER_API_KEY="your_openrouter_api_key_here"
OPENROUTER_TTS_MODEL="fish-audio/s2.1-pro-free:free"
